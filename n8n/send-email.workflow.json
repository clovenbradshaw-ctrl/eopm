    {
      "parameters": {
        "url": "={{ $env.MATRIX_HOMESERVER }}/_matrix/client/v3/profile/{{ encodeURIComponent($json.user_id) }}/displayname",
        "options": { "timeout": 10000 }
      },
      "id": "a1c2e3f4-3333-4a2b-9c3d-000000000003",
      "name": "Their display name",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, -208],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "notes": "Read from the homeserver, not from the request body, so the name on the email is one the sender actually owns. A user with no display name set is not an error — the Matrix ID is used instead."
    },
    {
      "parameters": {
        "jsCode": "// Build the outgoing mail from what the HOMESERVER said about the\n// caller, not from what the caller claimed about themselves.\n//\n// The From address is still the Gmail account this workflow is\n// connected to — Gmail will not let a workflow forge someone else's\n// address, and pretending otherwise would be the kind of thing that\n// gets a domain marked as a spoofer. What the recipient sees instead\n// is the sender's own display name, with their verified Matrix ID in\n// the body so there is always something checkable behind the name.\n\nconst body = $('Webhook').first().json.body || {};\nconst userId = $('Who is calling?').first().json.user_id;\n\nconst profile = $('Their display name').first().json || {};\nconst prettyName = (profile.displayname || '').trim() || userId;\n\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => (\n  { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]\n));\n\n// The signature is appended by us, from verified data, so a sender\n// cannot dress their message up as coming from somebody else.\nconst signature =\n  '<hr style=\"border:none;border-top:1px solid #ddd;margin:18px 0 10px\">' +\n  '<p style=\"color:#888;font-size:12px;margin:0\">' +\n  'Sent by <b>' + esc(prettyName) + '</b> (' + esc(userId) + ')' +\n  ($env.WORKSPACE_NAME ? ' via ' + esc($env.WORKSPACE_NAME) : '') +\n  '</p>';\n\nconst html = (body.html || (body.text ? '<p>' + esc(body.text) + '</p>' : '')) + signature;\n\nreturn [{\n  json: {\n    to: body.to,\n    cc: body.cc || '',\n    bcc: body.bcc || '',\n    replyTo: body.replyTo || '',\n    subject: body.subject || '(no subject)',\n    html,\n    senderName: prettyName,\n    userId,\n  },\n}];"
      },
      "id": "a1c2e3f4-4444-4a2b-9c3d-000000000004",
      "name": "Compose as that user",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-176, -208]
    },
